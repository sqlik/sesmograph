APP_NAME=sesmograph
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite; production uses MySQL/MariaDB:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sesmograph
# DB_USERNAME=sesmograph
# DB_PASSWORD=
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only):
# SESSION_SECURE_COOKIE=true

# Reverse proxies whose X-Forwarded-For is trusted (comma-separated IPs/CIDRs).
# The login and 2FA rate limiters key on the client IP, so do NOT set this to
# '*' unless the network blocks all direct access. Default is the local proxy.
# Behind Cloudflare: configure nginx real_ip with CF-Connecting-IP and keep the
# loopback, or list Cloudflare's IP ranges here.
# TRUSTED_PROXIES=127.0.0.1,::1

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Only used for framework mail (password resets are CLI-only, alerts use
# their own per-channel SMTP config) - safe to leave on log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# sesmograph never talks to AWS - events arrive via SNS webhooks.
# Retention (days); aggregates are kept forever:
# SESMOGRAPH_EVENT_RETENTION_DAYS=90
# SESMOGRAPH_CONTENT_RETENTION_DAYS=30
# SESMOGRAPH_CONTENT_MAX_BYTES=2097152

VITE_APP_NAME="${APP_NAME}"
